+const G4PhysicsTable* G4TablesForExtrapolatorForCVH::GetMuonRadiativeTable() {
+  if (G4PhysicsTable* t = dedxMuRad.load(std::memory_order_acquire)) {
+    return t;
+  }
+  // Same mutex as the build and the hadron tables: the models write
+  // process-wide Geant4 EM statics.
+  std::lock_guard<std::mutex> lk(cvhExtrapolatorTablesMutex());
+  if (G4PhysicsTable* t = dedxMuRad.load(std::memory_order_relaxed)) {
+    return t;
+  }
+  G4PhysicsTable* t = PrepareTable(nullptr);
+  ComputeMuonRadiativeDEDX(t);
+  dedxMuRad.store(t, std::memory_order_release);
+  return t;
+}
+
+void G4TablesForExtrapolatorForCVH::ComputeMuonRadiativeDEDX(G4PhysicsTable* table) {
+  // muonPlus for both charges and unrestricted cuts (cut = e), exactly as
+  // ComputeMuonDEDX builds the radiative half of the muon table and as
+  // Geant4ePropagator::computeRadiativeDEDX evaluates it per step.
+  G4MuPairProductionModel* pair = new G4MuPairProductionModel(muonPlus);
+  G4MuBremsstrahlungModel* brem = new G4MuBremsstrahlungModel(muonPlus);
+  pair->Initialise(muonPlus, cuts);
+  brem->Initialise(muonPlus, cuts);
+  pair->SetUseBaseMaterials(false);
+  brem->SetUseBaseMaterials(false);
+  const G4MaterialTable* mtable = G4Material::GetMaterialTable();
+  if (0 < verbose) {
+    G4cout << "G4TablesForExtrapolatorForCVH::ComputeMuonRadiativeDEDX for mu+ (layer-path term)" << G4endl;
+  }
+  for (G4int i = 0; i < nmat; ++i) {
+    const G4Material* mat = (*mtable)[i];
+    G4PhysicsVector* aVector = (*table)[i];
+    for (G4int j = 0; j <= nbins; ++j) {
+      const G4double e = aVector->Energy(j);
+      aVector->PutValue(j, pair->ComputeDEDXPerVolume(mat, muonPlus, e, e) + brem->ComputeDEDXPerVolume(mat, muonPlus, e, e));
+    }
+    if (splineFlag) {
+      aVector->FillSecondDerivatives();
+    }
+  }
+}
