+G4bool G4EnergyLossForExtrapolatorForCVH::RadiativeDEDXFromTable(G4double ekin,
+                                                                  const G4ParticleDefinition* part,
+                                                                  const G4Material* mat,
+                                                                  G4double& dedx) {
+  dedx = 0.0;
+  const G4int apdg = std::abs(part->GetPDGEncoding());
+  if (apdg == 11) {
+    return false;
+  }
+  if (mat->GetNumberOfMaterials() != nmat) {
+    Initialisation();
+  }
+  G4TablesForExtrapolatorForCVH* tb = tables.load(std::memory_order_acquire);
+  if (tb == nullptr) {
+    return false;
+  }
+  const G4PhysicsTable* t = nullptr;
+  if (apdg == 13) {
+    t = tb->GetMuonRadiativeTable();
+  } else {
+    if (!hadronRad) {
+      return true;  // 0, as computeRadiativeDEDX without CVH_REF_HADRAD
+    }
+    t = tb->GetHadronRadiativeTable(part);
+  }
+  if (t == nullptr) {
+    return false;
+  }
+  const G4double d = ComputeValue(ekin, t, mat->GetIndex());
+  // spline undershoot near zero, as in radDedxDelta
+  dedx = (d > 0.0 && std::isfinite(d)) ? d : 0.0;
+  return true;
+}
