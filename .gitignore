__init__.py
*.pyc
.*.swp
.#*
#*#
*~
*.pb

# ignore partially applied patches and their backup
*.rej
*.orig


# ignore files under the top level $CMSSW_BASE/src directory, but not its subdirectories
/*
!/*/

# ignore some IDE related files
*.xcodeproj
.vscode

#ignore mac specific file
.DS_Store

# --- W mass / CVH resolution study: run products, not source ---------------
# cmsRun writes its output next to the config (the CVH drivers have no
# output= option), and the toy geometry is REGENERATED by
# Analysis/HitAnalyzer/test/gen_toy_config.py -- committing either turns a
# stale scratch state into repo content.  Scoped to the directories this work
# actually pollutes rather than applied tree-wide, because upstream CMSSW
# legitimately tracks .root and .log files in several packages.
/Analysis/HitAnalyzer/test/*.root
/Analysis/HitAnalyzer/test/*.log
/Analysis/HitAnalyzer/data/tracker.xml
/Analysis/HitAnalyzer/test/toyPlanes_pt*.py
/TrackPropagation/Geant4e/test/*.log
# per-job scratch area used by the CVH campaigns
/runs/
# hand-made backups of the toy geometry
*.bak
*.keep
